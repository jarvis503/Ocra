<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_orca_brand"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="10dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_orca_brand" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:text="@string/app_name"
            android:textColor="@color/textPrimary"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Browse ferociously. Use no RAM."
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="32dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_shortcuts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="24dp" />

        <LinearLayout
            android:id="@+id/home_search_bar"
            android:layout_width="300dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_search_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="@color/colorTextSecondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Search or enter URL"
                android:textColor="@color/colorTextSecondary"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
