<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tor_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_tor_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connect to Tor"
        android:textColor="@color/textPrimary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_tor_dialog_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Choose connection method"
        android:textColor="@color/colorTextSecondary"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/rg_tor_bridge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_direct"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:buttonTint="@color/colorAccent"
            android:checked="true"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="Direct Connection (fastest)"
            android:textColor="@color/textPrimary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rb_obfs4"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:buttonTint="@color/colorAccent"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="obfs4 Bridge (recommended for censored networks)"
            android:textColor="@color/textPrimary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rb_snowflake"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:buttonTint="@color/colorAccent"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="Snowflake Bridge (uses domain fronting)"
            android:textColor="@color/textPrimary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rb_meek"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:buttonTint="@color/colorAccent"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="meek-azure Bridge (slowest but most reliable)"
            android:textColor="@color/textPrimary"
            android:textSize="14sp" />

    </RadioGroup>

    <LinearLayout
        android:id="@+id/layout_tor_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progress_tor_bootstrap"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="@color/colorDivider"
            android:progressTint="@color/colorAccent" />

        <TextView
            android:id="@+id/tv_tor_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Bootstrapping... 0%"
            android:textColor="@color/textPrimary"
            android:textSize="13sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tor_cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:minWidth="0dp"
            android:paddingHorizontal="16dp"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp"
            app:rippleColor="@color/colorDivider" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tor_connect"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="96dp"
            android:paddingHorizontal="20dp"
            android:text="Connect"
            android:textAllCaps="false"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            app:backgroundTint="@color/colorAccent"
            app:cornerRadius="10dp" />

    </LinearLayout>

</LinearLayout>
