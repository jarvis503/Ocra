<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <!-- SECTION 1: Top Toolbar (44dp) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/colorPrimary">

        <ImageButton
            android:id="@+id/btn_sidebar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tabs"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_sidebar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_back"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/textPrimary" />

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_forward"
            app:layout_constraintStart_toEndOf="@id/btn_sidebar"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/textPrimary" />

        <ImageButton
            android:id="@+id/btn_forward"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/forward"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_forward"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/address_bar_container"
            app:layout_constraintStart_toEndOf="@id/btn_back"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/textPrimary" />

        <LinearLayout
            android:id="@+id/address_bar_container"
            android:layout_width="0dp"
            android:layout_height="@dimen/address_bar_height"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_address_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_home"
            app:layout_constraintStart_toEndOf="@id/btn_forward"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btn_page_options"
                android:layout_width="26dp"
                android:layout_height="18dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                android:paddingStart="8dp"
                android:paddingEnd="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_shield"
                app:tint="@color/textPrimary" />

            <EditText
                android:id="@+id/et_address"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:ellipsize="end"
                android:gravity="center"
                android:hint="Search or enter URL"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri|textNoSuggestions"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/colorTextSecondary"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btn_reload"
                android:layout_width="26dp"
                android:layout_height="18dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/refresh"
                android:paddingStart="0dp"
                android:paddingEnd="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_reload"
                app:tint="@color/textPrimary" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_home"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/app_name"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_home"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_new_tab"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@id/address_bar_container"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/textPrimary" />

        <ImageButton
            android:id="@+id/btn_new_tab"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/new_tab"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_new_tab"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_tab_count_container"
            app:layout_constraintStart_toEndOf="@id/btn_home"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/textPrimary" />

        <FrameLayout
            android:id="@+id/btn_tab_count_container"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/tabs"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_back_to_normal"
            app:layout_constraintStart_toEndOf="@id/btn_new_tab"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_tabs"
                app:tint="@color/textPrimary" />

            <TextView
                android:id="@+id/tv_tab_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingTop="3dp"
                android:paddingEnd="3dp"
                android:paddingStart="0dp"
                android:text="1"
                android:textColor="@color/textPrimary"
                android:textSize="10sp"
                android:textStyle="bold" />

        </FrameLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_back_to_normal"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_back_to_normal_pill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Normal"
            android:textAllCaps="false"
            android:textColor="@color/textPrimary"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_menu"
            app:layout_constraintStart_toEndOf="@id/btn_tab_count_container"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_menu"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_back_to_normal"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/textPrimary" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 1dp top divider above tab strip -->
    <View
        android:id="@+id/tab_strip_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorDivider" />

    <!-- SECTION 2: Tab Strip (36dp) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tab_strip"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tab_strip_height"
        android:background="@color/colorTabStrip"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="0dp"
        android:paddingEnd="4dp"
        android:paddingBottom="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <!-- SECTION 3: Content Area -->
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/colorPrimary">

        <FrameLayout
            android:id="@+id/webview_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/home_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/overlay_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress_bar"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:max="100"
            android:progressBackgroundTint="@color/colorDivider"
            android:progressTint="@color/colorAccent"
            android:visibility="gone" />

        <include
            android:id="@+id/find_bar"
            layout="@layout/view_find_bar" />

    </FrameLayout>

</LinearLayout>
